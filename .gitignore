# Secrets — never commit
.env
*.env
!*.env.example
*.key
models.yaml

# Local language scheme and engine mappings (kept locally as examples, not tracked)
languages/

# Python
__pycache__/
*.py[cod]
.venv/

# Downloaded source tables (regenerate with scripts/build_default_scheme.py --refresh)
data/cache/

# Local run output: the database, the artifacts, the raw corpus. All regenerable.
data/llmlc.db
data/llmlc.db-*
data/controls/.qualification_cache.json

# FLORES-derived control text is CC BY-SA 4.0. Keeping it out of the tree leaves
# this repository MIT-clean; `python scripts/build_controls.py` regenerates it.
data/controls/flores.json

# Build artifacts
*.egg-info/

# User-supplied locale lists are never committed; the public catalogue is.
schemes/*.json
!schemes/default.json

# Model weights and run output (large, regenerable)
data/models/
data/corpus/
data/results/
