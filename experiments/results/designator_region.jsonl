{"tag": "gsw", "variant": "name+script", "designator": "German, Swiss (Latin script)", "spec": "market-fish-price", "verdict": "pass", "lid": "gsw_Latn", "detail": "", "text": "Der alte Mann kauft Fisch uf em Märit. D'Prise sind seit em letschte Jahr doppelt so hoch. Er chauft weniger als er vorhät het und lauft hei."}
{"tag": "gsw", "variant": "name+country", "designator": "German, Swiss (Switzerland)", "spec": "bus-rain-office", "verdict": "refused", "lid": null, "detail": "CANNOT", "text": "CANNOT"}
