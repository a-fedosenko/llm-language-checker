# --- Where the models come from -------------------------------------------
#
# Two routes. The first is the general one and the one to use; the second is
# the narrower case this project happened to be built on. Where both are set,
# the JSON file wins.
#
# 1. A JSON file listing your models, each with its OWN endpoint and key, so a
#    single scan can reach OpenAI, a hosted gateway and a local vLLM at once.
#    Copy .models.json.example to data/models.json and point this at it. Keys
#    live in that file only: they are never stored in the database, written to
#    a result, or sent anywhere but the endpoint listed beside them.
#    Under ./data because that is the directory compose mounts into the
#    container -- a path anywhere else resolves on the host and not in Docker.
CUSTOM_MODEL_LIST_PATH=data/models.json

# 2. One OpenAI-compatible gateway serving every model id, with one key.
#    Leave these blank if you are using the JSON file above.
# AGGREGATOR_BASE_URL=https://your-gateway.example.com
# AGGREGATOR_ADMIN_API_KEY=
# AGGREGATOR_MODEL_LIST_URL=https://your-gateway.example.com/v1/models

# The model that grades back-translations. It must be reachable by whichever
# route you chose above -- with a custom list, that means it has to be in the
# file. The default is this project's own id and will not be in yours.
# JUDGE_MODEL=gpt-4o-mini

# Where results are stored. SQLite only -- this is a single-tenant local tool.
# DATABASE_URL=sqlite+pysqlite:///data/llmlc.db

# Port for the local UI, if 8000 is taken on your machine.
# API_PORT=8000
# Interface the published port binds to. Loopback by default; there is no
# authentication, so widening this puts an unguarded tool on your network.
# API_BIND=127.0.0.1

# Who may start a scan from the browser. A scan spends the key above, so the
# endpoint that starts one is gated:
#   off       no trigger at all; scans stay a `llmlc scan` action
#   loopback  only callers on 127.0.0.1 / ::1  (right for a server on the host)
#   any       any client that can reach the port. **This is the compose default**,
#             because inside a container the caller is always the bridge gateway,
#             so `loopback` can never match and the UI's scan button would 403 for
#             everyone. The control there is the port binding: keep API_BIND on
#             loopback and only this machine can reach it.
# SCAN_TRIGGER=any
# Ceiling on a browser-started scan, whatever it asks for. The CLI has none.
# 5000 covers the natural first scan -- every living language with a control,
# 199 classes, ~2400 calls. Lower it if you want a tighter bound.
# SCAN_TRIGGER_MAX_CALLS=5000

# Fetch the first-run assets at startup instead of pressing the button in the UI:
# GlotLID (~1.6 GB) and the FLORES-derived back-translator controls (~25 MB
# download). Neither can ship in the repository -- one is too large, the other is
# CC BY-SA derived text. Without them a scan still runs and measures less than it
# reports, which the UI says plainly. Set to 1 for an unattended deployment.
# AUTO_BOOTSTRAP=0

# Optional: force a hardware profile instead of autodetecting. Note that no local
# back-translator exists yet, so the resolved profile is `api` regardless; see
# "Services as built" in docs/03.
# One of: auto | gpu-fp16 | gpu-int8 | cpu | api
HARDWARE_PROFILE=auto
